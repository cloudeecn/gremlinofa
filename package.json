{
  "name": "gremlinofa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git@github.com:cloudeecn/gremlinofa.git"
  },
  "scripts": {
    "dev": "vite",
    "prebuild:frontend": "tsc -b",
    "build:frontend": "vite build",
    "postbuild:frontend": "mkdir -p dist/frontend/src && cp scripts/pwa-recovery.js dist/frontend/src/main.js",
    "build": "npm run build:frontend && npm run build:server",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:silent": "CI=true prettier --write . | grep -v '(unchanged)' || true",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "verify": "CI=true prettier --check . && tsc -b && eslint .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:ci": "CI=true vitest run",
    "test:silent": "CI=true vitest run --no-color --silent passed-only",
    "build:server": "esbuild src/server/nodeEntry.ts --bundle --platform=node --target=node20 --outfile=dist/server/server.js --format=esm --external:better-sqlite3 --external:@anthropic-ai/claude-agent-sdk --external:@modelcontextprotocol/sdk --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\" && cp src/server/deploy/package.json src/server/deploy/.env.example src/server/deploy/gremlinofa-server.service src/server/deploy/gremlinofa-server.initd dist/server/ && cp node_modules/@jitl/quickjs-ng-wasmfile-release-sync/dist/emscripten-module.wasm dist/server/",
    "build:vfs-server": "mkdir -p dist/vfs-server && esbuild src/server/vfsFacade/entry.ts --bundle --platform=node --target=node18 --outfile=dist/vfs-server/index.js --format=esm --external:express --external:dotenv --sourcemap && cp src/server/vfsFacade/deploy/.env.example src/server/vfsFacade/deploy/gremlinofa-vfs.service src/server/vfsFacade/deploy/gremlinofa-vfs.initd dist/vfs-server/",
    "start:server": "node dist/server/server.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "0",
    "@anthropic-ai/sdk": "0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.143",
    "@aws-sdk/client-bedrock": "^3.978.0",
    "@aws-sdk/client-bedrock-runtime": "^3.978.0",
    "@google/genai": "^1.42.0",
    "@jitl/quickjs-ng-wasmfile-release-sync": "^0.32.0",
    "@jitl/quickjs-singlefile-browser-release-sync": "^0.32.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@smithy/eventstream-serde-browser": "^4.2.8",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^12.8.0",
    "dompurify": "^3.3.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "fflate": "^0.8.2",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.27",
    "marked": "^17.0.0",
    "mustache": "^4.2.0",
    "openai": "^6.9.0",
    "quickjs-emscripten-core": "^0.32.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "stacktrace-js": "^2.0.2",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.0",
    "@types/mustache": "^4.2.6",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/ui": "^4.0.13",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^27.2.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "tailwindcss": "^4.1.17",
    "tree-kill": "^1.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^4.0.13",
    "workbox-window": "^7.4.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md,yaml,html}": "prettier --write"
  }
}
