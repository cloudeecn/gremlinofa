# GremlinOFA Server Configuration
# Copy to .env and edit as needed
#
# Running several instances from one build? Point each at its own copy:
#   node server.js --instance-env /var/lib/gremlinofa/alice/.env
# With --instance-env, relative paths below (STORAGE_PATH, VFS_BASE_PATH,
# CLAUDE_AGENT_SESSION_DIR) resolve against this file's directory — the env
# file IS the instance. Without the flag: old behavior, ./.env from the
# working directory, relative paths from cwd.
#
# Values are taken literally after the first '=' — no quoting, no escapes,
# no shell expansion. Keep it simple and it keeps working.

# WebSocket listen port
PORT=3100

# Bind address (use 0.0.0.0 to listen on all interfaces)
HOST=127.0.0.1

# SQLite database file path
STORAGE_PATH=./data/gremlin.db

# VFS mode: 'filesystem' (real files on disk) or 'encrypted' (blobs in SQLite)
VFS_MODE=filesystem

# Base directory for filesystem VFS (only used when VFS_MODE=filesystem)
VFS_BASE_PATH=./data/vfs

# Follow symlinks under a project root? Default: false (any symlink rejected
# with 403, listings hide them). Set to true to opt in — the canonical path
# must still land inside an allowed root (see VFS_EXTRA_ROOTS).
# VFS_FOLLOW_SYMLINKS=false

# Extra mounts the VFS may resolve into. PATH-style colon-separated.
# Each entry is either:
#   /absolute/path                — allowed for all projects
#   projectId|/absolute/path      — scoped to a single project
# Project root is implicitly always allowed. Paths are realpath-resolved at
# boot; missing paths abort startup.
# Example:
# VFS_EXTRA_ROOTS=/srv/shared:projectA|/srv/projectA-only:/data/team

# Working directory for the spawned `claude` CLI when serving the
# claude-agent provider (subscription billing via Claude Max). Must be
# writable by the server user. Defaults to <dirname(STORAGE_PATH)>/claude-agent-sessions,
# which follows your STORAGE_PATH override. Set explicitly when the
# storage dir is read-only (e.g. /opt-style deploys) or you want to keep
# the CLI's working tree elsewhere.
#
# Note: the SDK's session JSONLs land under $HOME/.claude/projects/<dashified-cwd>/
# regardless — this dir is only the subprocess's working directory. So
# the server user also needs a writable $HOME with `claude setup-token`
# already done.
# CLAUDE_AGENT_SESSION_DIR=/var/lib/gremlinofa/claude-agent-sessions
