[Unit]
Description=GremlinOFA WebSocket Server - Node backend with SQLite + filesystem VFS
Documentation=https://github.com/cloudeecn/gremlinofa
After=network.target

[Service]
Type=simple
User=gremlinofa
Group=gremlinofa
WorkingDirectory=/opt/gremlinofa-server
ExecStart=/usr/bin/node /opt/gremlinofa-server/server.js
Restart=on-failure
RestartSec=5

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/gremlinofa-server

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gremlinofa-server

[Install]
WantedBy=multi-user.target
