# Server port (default: 3003)
PORT=3003

# CORS origin (empty = same-domain only, * = allow all, single origin, or comma-separated list)
# Examples:
#   CORS_ORIGIN=https://example.com
#   CORS_ORIGIN=https://app.example.com,https://staging.example.com
#   CORS_ORIGIN=*
CORS_ORIGIN=

# Root directory for all user files (default: ./data)
DATA_DIR=./data

# Server-wide password for Basic Auth validation (empty = dev mode, skip password check)
AUTH_PASSWORD=

# Follow symlinks under a project root? Default: false (any symlink rejected
# with 403, listings hide them). Set to true to opt in — the canonical path
# must still land inside an allowed root (see VFS_EXTRA_ROOTS).
# VFS_FOLLOW_SYMLINKS=false

# Extra mounts the VFS may resolve into. PATH-style colon-separated.
# Each entry is either:
#   /absolute/path                — allowed for all projects
#   projectId|/absolute/path      — scoped to a single project
# Project root is implicitly always allowed. Paths are realpath-resolved at
# boot; missing paths abort startup.
# Example:
# VFS_EXTRA_ROOTS=/srv/shared:projectA|/srv/projectA-only:/data/team
