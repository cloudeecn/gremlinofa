{
  "name": "@gremlinofa/storage-sqlite",
  "version": "1.0.0",
  "type": "module",
  "description": "SQLite-based remote storage backend for GremlinOFA - because your data deserves a proper home, not some flimsy IndexDB",
  "main": "dist/index.js",
  "license": "Apache-2.0",
  "scripts": {
    "build": "node esbuild.config.js",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:silent": "CI=true vitest run --no-color --silent passed-only",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "CI=true prettier --check . && tsc --noEmit && eslint ."
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20"
  }
}
