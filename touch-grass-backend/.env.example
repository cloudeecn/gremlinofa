# Copy to .env next to index.js. The server reads .env from its working directory, or the file
# DOTENV_CONFIG_PATH names. A missing file is skipped; one it can't read stops the server.
# Values containing '#' must be quoted (dotenv cuts an unquoted value at '#'); single quotes
# are the safe habit, e.g. API_PASSWORD='abc#def'.

# Required. Shared secret for GremlinOFA minion tool callers (the "Remote Minion Password").
# The server refuses to start while this is empty. Generate one with: openssl rand -hex 24
API_PASSWORD=

# Required. Password for humans signing in to the web UI at /web/.
# The server refuses to start while this is empty. Generate one with: openssl rand -hex 24
WEB_PASSWORD=

# Server port (default: 3004)
PORT=3004

# Bind address (default: unset = all interfaces). Use 127.0.0.1 behind a local reverse proxy.
# HOST=127.0.0.1

# Origins allowed to call /api from a browser: scheme + host (+ port) only, no path or
# trailing slash. Comma-separated list, or * for any origin. GremlinOFA running in the
# browser (worker mode, e.g. the hosted app) needs its origin listed here; server-mode
# GremlinOFA calls from Node and doesn't care. The hosted app also needs this backend on
# HTTPS, since browsers block http:// calls from an https:// page.
# CORS_ORIGIN=https://cloudeecn.github.io

# SQLite database file (default: ./data/touch-grass.db). The directory is created at startup.
DB_PATH=./data/touch-grass.db

# Express "trust proxy" setting, for running behind a reverse proxy (default: false).
# true, false, a hop count (1), or addresses/subnets such as loopback or 10.0.0.0/8.
# Avoid true: it trusts X-Forwarded-For/-Proto/-Host from any client, so anyone can spoof their
# address past the login backoff and fake the Secure cookie flag and the Host/Origin check.
# Use loopback, the proxy's address, or a hop count of 1 instead.
# TRUST_PROXY=loopback

# Delete sessions idle for more than this many days (default: 30, 0 = keep forever, max 36500).
# Sessions with a question still waiting for an answer are never deleted.
SESSION_RETENTION_DAYS=30

# Longest a single long-poll is held open, in ms (default: 30000, range: 1000-2147483647).
# A reverse proxy in front needs a read timeout above this.
POLL_TIMEOUT_MS=30000
